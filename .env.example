# stock-analysis 環境變數範本
# 複製為 .env 並填入真實值：cp .env.example .env

# DeepSeek API（AI 分析用）
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ── stockbot 選項（可不填，以下為預設值）──
# 每日 LLM 花費上限（美元），達到就停止呼叫
STOCKBOT_DAILY_BUDGET_USD=0.5
# DeepSeek 餘額低於此金額（美元）時，在日報與 Telegram 摘要中提醒
STOCKBOT_LOW_BALANCE_USD=2
# 每百萬 token 價格（美元），只用來估算花費，請依 DeepSeek 官網價格調整
STOCKBOT_PRICE_IN=0.28
STOCKBOT_PRICE_OUT=0.42
# 1 = 每日/每週分析完自動 git commit + push 報告與 memory/
STOCKBOT_GIT_PUBLISH=1
# 網頁儀表板埠號
STOCKBOT_WEB_PORT=5000
